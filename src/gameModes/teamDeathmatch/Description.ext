class Params {
    #include "TDM\params.hpp"
    #include "TDM\maps\mapName.hpp"
};

class CfgFunctions {
    // compiles all TDM function files (TDM\functions.sqf) on every machine before any init script or
    // remoteExec message runs; the call in initServer.sqf / initPlayerLocal.sqf is then a no-op
    class DM_bootstrap {
        tag = "DM";

        class game {
            class compileFunctions {
                file = "TDM\functions.sqf";
                preInit = 1;
            };
        };
    };
};

