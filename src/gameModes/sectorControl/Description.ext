class CfgFunctions {
    // compiles all SC files (SC\functions.sqf) on every machine before any init script or
    // JIP / remoteExec message runs; the calls in initServer.sqf / initPlayerLocal.sqf are then no-ops
    class SC_bootstrap {
        tag = "SC";

        class game {
            class compileFunctions {
                file = "SC\functions.sqf";
                preInit = 1;
            };
        };
    };
};

