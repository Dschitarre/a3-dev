class CfgFunctions {
    // compiles all GG function files (GG\functions.sqf) on every machine before any init script or
    // remoteExec message runs; the call in initServer.sqf / initPlayerLocal.sqf is then a no-op
    class GG_bootstrap {
        tag = "GG";

        class game {
            class compileFunctions {
                file = "GG\functions.sqf";
                preInit = 1;
            };
        };
    };
};

