class Params {
    #include "BR\params.hpp"
};

class CfgFunctions {
    // compiles all BR function files (BR\functions.sqf) on every machine before any init script or
    // remoteExec message runs; the call in initServer.sqf / initPlayerLocal.sqf is then a no-op
    class BR_bootstrap {
        tag = "BR";

        class game {
            class compileFunctions {
                file = "BR\functions.sqf";
                preInit = 1;
            };
        };
    };
};

enableDebugConsole = 1;
