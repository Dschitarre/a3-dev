/*
    Loads the mod scripts embedded in the mission under modsIntegrated\<mod>\scripts\.
    The mod list (modsIntegrated\modList.sqf) is generated by scripts\build.ps1 from cfg\modsIntegrated.txt.

    Usage:
        ["server"] call compile preprocessFileLineNumbers "modsIntegrated\loadMods.sqf";   // initServer.sqf
        ["client"] call compile preprocessFileLineNumbers "modsIntegrated\loadMods.sqf";   // initPlayerLocal.sqf
        ["all"]    call compile preprocessFileLineNumbers "modsIntegrated\loadMods.sqf";   // init.sqf (singleplayer)

    "server" loads fnc_server.sqf + fnc_clientServer.sqf, "client" loads fnc_clientServer.sqf + fnc_client.sqf,
    "all" loads fnc_server.sqf only if isServer; fnc_client.sqf is only loaded with an interface (not on headless
    clients, which run initPlayerLocal.sqf too and so get fnc_clientServer.sqf for their local AI).
    Every file is compiled at most once per machine, so on a hosted server initServer.sqf and
    initPlayerLocal.sqf can both call this without running fnc_clientServer.sqf twice. Both run
    scheduled and in parallel there, so a pass that finds a file already being loaded by the other
    pass waits until it is finished instead of skipping it.
*/
params [["_scope", "all", [""]]];

_scope = toLower _scope;

// Registering a settings hook marks CBA as available for this mission.
if (isServer && {_scope in ["server", "all"]} && {!isNil "MODS_var_settingsReady"}) then {
    waitUntil {MODS_var_settingsReady};
};

private _fileNames = [];

if ((_scope == "server") || {(_scope == "all") && isServer}) then {
    _fileNames pushBack "fnc_server";
};

_fileNames pushBack "fnc_clientServer";

// headless clients run initPlayerLocal.sqf too, but have no interface for the client part
if ((_scope in ["client", "all"]) && hasInterface) then {
    _fileNames pushBack "fnc_client";
};

// isNil {} runs unscheduled, so the two passes can't both create the lists
isNil {
    if (isNil "MODS_var_loadingFiles") then {
        MODS_var_loadingFiles = [];
        MODS_var_loadedFiles = [];
    };
};

private _mods = call compile preprocessFileLineNumbers "modsIntegrated\modList.sqf";

{
    private _mod = _x;

    {
        private _path = format ["modsIntegrated\%1\scripts\%2.sqf", _mod, _x];
        private _key = toLower _path;

        if (fileExists _path) then {
            if ((MODS_var_loadingFiles pushBackUnique _key) != -1) then {
                call compile preprocessFileLineNumbers _path;
                MODS_var_loadedFiles pushBack _key;
            } else {
                waitUntil {_key in MODS_var_loadedFiles};
            };
        };
    } forEach _fileNames;
} forEach _mods;
